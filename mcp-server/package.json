{
  "name": "wled-lights-mcp",
  "version": "0.1.0",
  "description": "MCP server for designing and controlling WLED lighting scenes",
  "license": "MIT",
  "author": "David Christiansen",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidray/superlights.git",
    "directory": "mcp-server"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "wled-lights-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "trigger": "node dist/triggerServer.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/*.test.js && node scripts/check-tool-schemas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^17.4.2",
    "suncalc": "^2.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/suncalc": "^1.9.2",
    "typescript": "^5.7.2"
  }
}
