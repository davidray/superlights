# Copy to .env (gitignored) and fill in.

# --- trigger add-on's own server (mcp-server/deploy), used when this .env is baked
#     into that container's environment -- not typically needed in a local .env ---
# Generate a token with: openssl rand -hex 32
TRIGGER_SERVER_PORT=8788
TRIGGER_SERVER_TOKEN=changeme

# --- local MCP server -> remote trigger server (holiday schedule tools) ---
# TRIGGER_SERVER_URL is the Mac mini's address and the trigger add-on's port.
# TRIGGER_SERVER_TOKEN above must match the token configured in the add-on's
# Configuration tab (same value as TRIGGER_SERVER_TOKEN, listed once above).
TRIGGER_SERVER_URL=http://192.168.1.x:8788
