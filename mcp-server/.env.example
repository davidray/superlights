# Copy to .env (gitignored) and fill in.

# --- trigger add-on's own server (mcp-server/deploy), used when this .env is baked
#     into that container's environment -- not typically needed in a local .env ---
# Generate a token with: openssl rand -hex 32
TRIGGER_SERVER_PORT=8788
TRIGGER_SERVER_TOKEN=changeme

# --- local MCP server -> remote trigger server (holiday schedule, devices, calibration) ---
# TRIGGER_SERVER_URL is the always-on host's address and the trigger add-on's port.
# TRIGGER_SERVER_TOKEN above must match the token configured in the add-on's
# Configuration tab (same value as TRIGGER_SERVER_TOKEN, listed once above).
TRIGGER_SERVER_URL=http://192.168.1.x:8788

# --- optional: point this local MCP server at your own config files instead of the
#     defaults under mcp-server/. Useful so your real devices.json/calibration/ can
#     stay untracked while the repo's committed copies stay generic examples. ---
# WLED_DEVICES_CONFIG=/absolute/path/to/devices.local.json
# WLED_HOLIDAY_SCHEDULE_CONFIG=/absolute/path/to/holidaySchedule.local.json
# WLED_CALIBRATION_DIR=/absolute/path/to/calibration
