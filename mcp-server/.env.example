# Copy to .env (gitignored) and fill in.

# --- trigger server (mcp-server/deploy) ---
# Generate a token with: openssl rand -hex 32
TRIGGER_SERVER_PORT=8788
TRIGGER_SERVER_TOKEN=changeme

# --- schedule tools (get_schedule / set_schedule) ---
# HA_TOKEN is a long-lived access token: HA profile page (bottom-left avatar) ->
# Security tab -> "Create Token".
HA_BASE_URL=http://homeassistant.local:8123
HA_TOKEN=changeme
